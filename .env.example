# === Database ===
DATABASE_URL=postgresql://postgres:your-password-here@localhost:5432/resonant

# === Colab-Hosted AI Services ===
# These URLs are set when you start your Colab notebooks
# They will look like: https://xxxx-xx-xxx-xxx-xx.ngrok-free.app
COLAB_LLM_URL=http://localhost:11434
COLAB_TTS_URL=http://localhost:5002

# === Local STT Model ===
WHISPER_MODEL_SIZE=tiny

# === Optional: ElevenLabs (if you have an API key) ===
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here

# === App Settings ===
DEFAULT_LANGUAGE=en
LOG_LEVEL=DEBUG
OUTPUT_DIR=outputs
